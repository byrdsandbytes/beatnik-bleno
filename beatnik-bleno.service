[Unit]
Description=Beatnik Bleno Service
After=network.target bluetooth.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/beatnik-bleno
ExecStart=/usr/bin/node /opt/beatnik-bleno/dist/main.js
Restart=always
RestartSec=10
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
